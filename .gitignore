```gitignore
# ==============================
# Project 23 - Agentic AI
# ==============================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Datasets
data/*
!data/.gitkeep
!data/README.md

# Trained models and checkpoints
models/*
!models/.gitkeep
*.pkl
*.joblib
*.pt
*.pth
*.ckpt
*.h5
*.onnx

# Jupyter Notebook
.ipynb_checkpoints/

# Testing and cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Build files
build/
dist/
*.egg-info/
```